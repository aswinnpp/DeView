# =================================================================
# DeView Frontend — Environment Variables
# Copy this file to .env and fill in values for your environment.
# All variables must be prefixed with VITE_ to be accessible.
# =================================================================

# ─────────────────────────────────────────────────────────────────
# BACKEND API  [REQUIRED]
# Use /api when frontend is reverse-proxied alongside the backend.
# Use https://your-backend.example.com for separate deployments.
# ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=/api

# ─────────────────────────────────────────────────────────────────
# SOCKET.IO  [OPTIONAL]
# Leave blank to derive the socket URL from VITE_API_BASE_URL.
# Set explicitly when the socket server is on a separate host.
# ─────────────────────────────────────────────────────────────────
VITE_SOCKET_URL=

# ─────────────────────────────────────────────────────────────────
# STRIPE  [REQUIRED when payments are enabled]
# ─────────────────────────────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ─────────────────────────────────────────────────────────────────
# WebRTC — ICE / STUN / TURN  [OPTIONAL]
#
# VITE_STUN_URLS  — Comma-separated STUN server URIs.
#   Leave blank to use the Google public STUN server as fallback.
#
# VITE_TURN_URLS  — Comma-separated TURN server URIs.
#   Leave blank to disable TURN (peer connections may fail behind NAT).
#
# VITE_TURN_USERNAME / VITE_TURN_CREDENTIAL — TURN auth credentials.
#   Required when VITE_TURN_URLS is set.
#
# NOTE: These values are embedded in the browser JS bundle.
#       For production, consider rotating TURN credentials regularly
#       or implementing server-side ephemeral credential generation.
# ─────────────────────────────────────────────────────────────────
VITE_STUN_URLS=stun:stun.l.google.com:19302
VITE_TURN_URLS=turn:your-turn-server.example.com:3478?transport=udp,turn:your-turn-server.example.com:3478?transport=tcp
VITE_TURN_USERNAME=your_turn_username
VITE_TURN_CREDENTIAL=your_turn_credential

# ─────────────────────────────────────────────────────────────────
# WebRTC TUNING  [OPTIONAL — defaults shown]
# ─────────────────────────────────────────────────────────────────
VITE_ICE_CANDIDATE_POOL_SIZE=10

# ─────────────────────────────────────────────────────────────────
# NOTIFICATIONS  [OPTIONAL — defaults shown]
# ─────────────────────────────────────────────────────────────────
VITE_NOTIFICATIONS_FETCH_LIMIT=50

# ─────────────────────────────────────────────────────────────────
# DEBUG FLAGS  [OPTIONAL]
# ─────────────────────────────────────────────────────────────────
VITE_WEBRTC_DEBUG=false
