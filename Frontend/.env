# Same-origin API (reverse-proxy `/api` → backend). Dev: Vite proxies `/api` to VITE_DEV_PROXY_TARGET.
VITE_API_BASE_URL=/api

# Leave empty to use `window.location.origin` for Socket.IO (same-origin cookies).
VITE_SOCKET_URL=

# Only used by `vite` dev server proxy (npm run dev). Production build ignores this.
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:3000
VITE_WEBRTC_DEBUG=true
